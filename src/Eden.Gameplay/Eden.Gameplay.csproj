<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="Eden.Protocol.Tests" />
  </ItemGroup>
  <Target Name="CheckGameplayDependencies" BeforeTargets="ResolveReferences">
    <Error
      Condition="'@(ProjectReference)' != '' Or '@(PackageReference)' != ''"
