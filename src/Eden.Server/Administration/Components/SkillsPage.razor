@page "/skills"
@attribute [Authorize(Policy = AdministratorAccounts.Policy)]
@using Eden.Gameplay.Skills
@inject AdministrationOperations Operations
@inject AuthenticationStateProvider Authentication
<PageTitle>Skills · Eden</PageTitle>
<NavigationLock ConfirmExternalNavigation="Dirty" OnBeforeInternalNavigation="BeforeNavigate" />
<h1>Skill editor</h1>
<p class="muted">Edit original skills or create your own. Original definitions stay available for restoration.</p>
@if (Error is not null)
{
    <p class="error" role="alert">@Error</p>
}
@if (Message is not null)
{
    <p class="notice" role="status">@Message</p>
}
@if (DiscardAction is not null)
{
    <section class="card" role="alert">
        <h2>Unsaved changes</h2>
        <p>Discard this draft to continue?</p>
        <button @onclick="Discard">Discard draft and continue</button>
        <button class="secondary" @onclick="KeepDraft">Keep editing</button>
    </section>
}
@if (Snapshot is null || Options is null)
{
    <p>Loading skills…</p>
}
else
{
    <section class="card">
        <h2>Publish to game clients</h2>
        <p>Save your edits, then build a package. Restart the server to activate it. The launcher installs the matching package before login.</p>
        <p class="muted">Active: @(Publication?.Active is { } active ? $"revision {active.Generation}" : "Original skills") ·
            Pending restart: @(Publication?.Pending is { } pending ? $"revision {pending.Generation}" : "None") · Saved revision @Snapshot.Generation</p>
        <label>Unchanged source client folder on the server
            <input @bind="ClientRoot" placeholder="E:\EdenDev\3662168" />
        </label>
        <p class="muted">Use a build-3662168 copy containing tq and ResFiles. Packaging reads this copy; players receive the package through the launcher.</p>
        <button disabled="@(Busy || Dirty || string.IsNullOrWhiteSpace(ClientRoot))" @onclick="Publish">@(Busy ? "Working…" : "Build and stage package")</button>
    </section>
    <div class="skill-workspace">
        <SkillBrowser Snapshot="Snapshot" SelectedId="Selected?.Definition.TypeId" Busy="Busy"
                      OnChoose="Choose" OnNew="New" OnReload="Reload" />
        <section class="card">
            @if (Form is null || Context is null)
            {
                <h2>Choose a skill</h2>
                <p>Select an existing skill, or create a new one.</p>
            }
            else
            {
                <h2>@(Form.TypeId == 0 ? "Create a skill" : Form.Name)</h2>
                <p class="muted">@(Selected?.UserCreated == true ? "User-created skill" : Form.TypeId == 0 ? "The server assigns a unique ID when saved." : "Original skill · protected from deletion")
                    @if (Dirty) { <span class="badge">Unsaved draft</span> }</p>
                <EditForm EditContext="Context" OnValidSubmit="Save" @key="Context">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <fieldset disabled="@(Busy || Selected?.Deleted == true)">
                        <label>Name <InputText @bind-Value="Form.Name" /></label>
                        <label>Description <InputTextArea rows="5" @bind-Value="Form.Description" /></label>
                        <div class="grid">
                            <SkillChoice TValue="int" Label="Skill group" Options="Options.Groups" @bind-Value="Form.GroupId" />
                            <label>Skillbook base price (ISK) <InputNumber @bind-Value="Form.BasePrice" min="0" step="any" /></label>
                            <label>Training multiplier <InputNumber @bind-Value="Form.Rank" min="0.01" max="1000" step="any" /></label>
                            <label>Primary attribute
                                <InputSelect @bind-Value="Form.PrimaryAttribute">
                                    @foreach (var attribute in TrainingAttributes) { <option value="@(attribute.Id)">@(attribute.Name)</option> }
                                </InputSelect>
                            </label>
                            <label>Secondary attribute
                                <InputSelect @bind-Value="Form.SecondaryAttribute">
                                    @foreach (var attribute in TrainingAttributes) { <option value="@(attribute.Id)">@(attribute.Name)</option> }
                                </InputSelect>
                            </label>
                        </div>
                        <label><InputCheckbox @bind-Value="Form.Published" /> Published and available for injection</label>
                        <h3>Prerequisites</h3>
                        @foreach (var required in Form.Prerequisites)
                        {
                            <div class="skill-input-row" @key="required">
                                <SkillChoice TValue="int" Label="Required skill" Options="PrerequisiteOptions" @bind-Value="required.TypeId" />
                                <label>Level <InputNumber @bind-Value="required.Level" min="1" max="5" /></label>
                                <button type="button" class="secondary" @onclick="() => RemovePrerequisite(required)">Remove prerequisite</button>
                            </div>
                        }
                        <button type="button" class="secondary" disabled="@(Form.Prerequisites.Count >= 6)" @onclick="AddPrerequisite">Add prerequisite</button>
                        <h3>Alpha training limits</h3>
                        <p class="muted">Zero requires Omega. Omega skills can train through level V.</p>
                        <div class="grid">
                            @foreach (var limit in Form.AlphaLimits)
                            {
                                <label>@RaceName(limit.RaceId) <InputNumber @bind-Value="limit.Level" min="0" max="5" /></label>
                            }
                        </div>
                        <h3>Appearance and bonuses</h3>
                        <button type="button" class="secondary" aria-expanded="@ShowAdvanced" @onclick="ToggleAdvanced">
                            @(ShowAdvanced ? "Hide appearance and bonuses" : "Edit appearance and bonuses")
                        </button>
                        @if (ShowAdvanced)
                        {
                            <div class="grid">
                                <SkillChoice TValue="int?" Label="Icon" EmptyLabel="No icon" Options="Options.Icons" @bind-Value="Form.IconId" />
                                <SkillChoice TValue="int?" Label="Market group" EmptyLabel="No market group" Options="Options.MarketGroups" @bind-Value="Form.MarketGroupId" />
                            </div>
                            <p class="muted">Search by name or description. Effect details show the attributes used by a bonus. Values use the catalog's stored units.</p>
                            @if (Selected is { CanEditBonuses: false })
                            {
                                <p class="muted">This original skill's bonuses have a dedicated gameplay calculation and are retained.</p>
                            }
                            <fieldset disabled="@(Selected is { CanEditBonuses: false })">
                                <h3>Additional attributes</h3>
                                @foreach (var attribute in Form.Attributes)
                                {
                                    <div class="skill-input-row" @key="attribute">
                                        <SkillChoice TValue="int" Label="Bonus attribute" Options="Options.Attributes" @bind-Value="attribute.AttributeId" />
                                        <label>Value <InputNumber @bind-Value="attribute.Value" step="any" /></label>
                                        <button type="button" class="secondary" @onclick="() => RemoveAttribute(attribute)">Remove attribute</button>
                                    </div>
                                }
                                <button type="button" class="secondary" @onclick="AddAttribute">Add attribute</button>
                                <h3>Effects</h3>
                                <p class="muted">Only passive ship and module effects supported by Eden can be added. Existing effects remain visible.</p>
                                @foreach (var effect in Form.Effects)
                                {
                                    <div class="skill-input-row" @key="effect">
                                        <SkillChoice TValue="int" Label="Bonus effect" Options="Options.Effects" @bind-Value="effect.EffectId" />
                                        <label><InputCheckbox @bind-Value="effect.IsDefault" /> Default effect</label>
                                        <button type="button" class="secondary" @onclick="() => RemoveEffect(effect)">Remove effect</button>
                                    </div>
                                }
                                <button type="button" class="secondary" @onclick="AddEffect">Add effect</button>
                            </fieldset>
                        }
                        <div class="toolbar">
                            <button type="submit">@(Form.TypeId == 0 ? "Create skill" : "Save skill")</button>
                            <button type="button" class="secondary" @onclick="ResetDraft">Discard draft</button>
                        </div>
                    </fieldset>
                </EditForm>
                @if (Selected is { } selected)
                {
                    <div class="toolbar">
                        <button class="secondary" disabled="@Busy" @onclick="Duplicate">Create a copy</button>
                        @if (!selected.UserCreated)
                        {
                            <button class="secondary" disabled="@Busy" @onclick="RestoreOriginal">Restore original values</button>
                        }
                        else if (!selected.Deleted)
                        {
                            <button class="danger" disabled="@Busy" @onclick="ConfirmDelete">Remove custom skill</button>
                        }
                    </div>
                    @if (Deleting)
                    {
                        <p>Remove <strong>@selected.Definition.Name</strong>? Its history is retained and it can be restored.</p>
                        <button class="danger" disabled="@Busy" @onclick="Delete">Confirm removal</button>
                        <button class="secondary" @onclick="CancelDelete">Cancel</button>
                    }
                    @if (selected.Original is { } original)
                    {
                        <details><summary>Original catalog values</summary>
                            <p><strong>@original.Name</strong> · multiplier @original.Rank · base price @original.BasePrice ISK</p>
                            <p>@original.Description</p>
                        </details>
                    }
                    <h3>Revision history</h3>
                    @if (History.Count == 0) { <p class="muted">No saved changes.</p> }
                    @foreach (var revision in History)
                    {
                        <div class="skill-history">
                            <p>Revision @revision.Id · @revision.Operation by @revision.Author<br /><small>@revision.CreatedAt.ToString("u") · @revision.Definition.Name</small></p>
                            <button class="secondary" disabled="@Busy" @onclick="() => RestoreRevision(revision.Id)">Restore this revision</button>
                        </div>
                    }
                }
            }
        </section>
    </div>
}
