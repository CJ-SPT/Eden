@page "/population"
@attribute [Authorize(Policy = AdministratorAccounts.Policy)]
@using Eden.Gameplay.Capsuleers
@inject AdministrationOperations Operations
@inject AuthenticationStateProvider Authentication
@inject Eden.World.Catalog.CatalogProvider Catalog
<PageTitle>Population · Eden</PageTitle>
<h1>Autonomous population</h1>
<button class="secondary" @onclick="Load">Refresh population</button>
<p class="muted">Ordinary pilots run in occupied systems. Active roaming gangs and escorted shipments continue while anyone is playing.
    All pilots pause when the last player leaves, retaining their ships, possessions and pending work.</p>
@if (Error is not null)
{
    <p class="error" role="alert">@Error</p>
}
@if (Snapshot is { } snapshot)
{
    <section class="card">
        <h2>Active population settings</h2>
        <p>Active bot slots: @snapshot.Population.EnabledAgents / @(snapshot.Policy.ActivePilotCap == 0 ? "Unlimited" : snapshot.Policy.ActivePilotCap.ToString()) ·
            Default region access: @CapsuleerPopulationRules.Describe(snapshot.Policy.DefaultRegionAccess)</p>
        <p>Player bots: @(snapshot.Policy.Enabled ? "On" : "Off") · Mining fleets: @(snapshot.Policy.Miners ? "On" : "Off") ·
            Trade-good shipments: @(snapshot.Policy.TradeGoodsFreight ? "On" : "Off") ·
            Data and relic exploration: @(snapshot.Policy.Exploration ? "On" : "Off")</p>
        <p>Fresh-universe careers · Couriers: @(snapshot.Policy.FreshCourierPilots ? "On" : "Off") ·
            Bounty hunters: @(snapshot.Policy.FreshBountyPilots && snapshot.Policy.BeltRatting ? "On" : "Off")</p>
        <p>Prepare bots in unvisited systems (fresh universes): @(snapshot.Policy.PrepareUnvisitedSystems ? "On" : "Off")</p>
        <p>Corporation formation and recruitment: @(snapshot.Policy.AutomaticRecruitment ? "On" : "Off") ·
            Form and grow alliances: @(snapshot.Policy.AutomaticAlliances ? "On" : "Off") ·
            Start new sovereignty claims: @(snapshot.Policy.NewSovereigntyClaims ? "On" : "Off")</p>
        @if (snapshot.Policy.ActivePilotCap > 0 && snapshot.Population.EnabledAgents >= snapshot.Policy.ActivePilotCap)
        {
            <p role="status">All active bot slots are in use. Eden will defer additional founders.</p>
        }
        @if (snapshot.Policy.RegionAccess.Count > 0)
        {
            <h3>Region overrides</h3>
            <ul>
                @foreach (var rule in snapshot.Policy.RegionAccess.OrderBy(rule => Catalog.Regions.GetValueOrDefault(rule.Key)))
                {
                    <li>@Catalog.Regions.GetValueOrDefault(rule.Key, rule.Key.ToString()) · @CapsuleerPopulationRules.Describe(rule.Value)</li>
                }
            </ul>
        }
        @if (snapshot.Policy.SystemAccess.Count > 0)
        {
            <h3>System overrides</h3>
            <ul>
                @foreach (var rule in snapshot.Policy.SystemAccess.OrderBy(rule => Name(rule.Key)))
                {
                    <li>@Name(rule.Key) · @CapsuleerPopulationRules.Describe(rule.Value)</li>
                }
            </ul>
        }
        <p>Ambient traffic · Station travelers: @snapshot.Policy.TrafficMultiplier× · Visitors per watched gate: @snapshot.Policy.GateVisitors</p>
    </section>
    <section class="card">
        <h2>Coverage</h2>
        <dl class="readings">
            <div><dt>Prepared systems · current settings</dt><dd>@snapshot.Population.PreparedSystems</dd></div>
            <div><dt>Eligible prepared systems</dt><dd>@snapshot.Population.PreparedEligibleSystems</dd></div>
            <div><dt>Saved communities</dt><dd>@snapshot.Population.Communities</dd></div>
            <div><dt>Saved pilots</dt><dd>@snapshot.Population.Agents</dd></div>
            <div><dt>Enabled pilots</dt><dd>@snapshot.Population.EnabledAgents</dd></div>
            <div><dt>Paused pilots</dt><dd>@snapshot.Population.PausedAgents</dd></div>
            <div><dt>Scheduled pilots</dt><dd>@snapshot.Runtime.ScheduledAgents</dd></div>
            <div><dt>Pilots in watched systems</dt><dd>@snapshot.MaterializedPilots</dd></div>
        </dl>
        <p class="muted">Saved totals include dormant pilots. Occupied systems prepare first.</p>
    </section>
    <section class="card">
        <h2>Waiting pilots</h2>
        @if (snapshot.Runtime.Blocked.Count == 0)
        {
            <p class="muted">No waiting reasons have been reported in this process.</p>
        }
        @foreach (var reason in snapshot.Runtime.Blocked)
        {
            <p>@reason.Agents · @reason.Reason</p>
        }
    </section>
    <section class="card">
        <h2>Regional conflicts</h2>
        @if (snapshot.RegionalConflicts.Count == 0)
        {
            <p class="muted">No regional operations have been established yet.</p>
        }
        @foreach (var region in snapshot.RegionalConflicts)
        {
            <h3>@Catalog.Regions.GetValueOrDefault(region.RegionId, "Unknown region")</h3>
            <div class="scroll"><table><thead><tr><th>Group</th><th>Home</th><th>Threat pressure</th><th>Losses</th><th>Kills</th></tr></thead><tbody>
                @foreach (var group in region.Groups)
                {
                    <tr><td>@group.Name</td><td>@Name(group.HomeSystemId)</td><td>@group.Pressure / 100</td><td>@group.Losses</td><td>@group.Kills</td></tr>
                }
            </tbody></table></div>
            @foreach (var operation in region.Operations.Take(20))
            {
                <p>@(region.Groups.FirstOrDefault(group => group.Id == operation.Key.GroupId)?.Name) · @operation.Objective ·
                    @Name(operation.TargetSystemId) · @operation.Status · @operation.Reason</p>
            }
        }
    </section>
    <section class="card">
        <h2>System eligibility records</h2>
        <div class="toolbar">
            <label>System name or ID<input @bind="Search" @bind:after="ResetPage" /></label>
            <label>Eligibility<select @bind="Reason" @bind:after="ResetPage">
                <option value="">All systems</option>
                @foreach (var value in Enum.GetValues<CapsuleerEligibility>())
                {
                    <option value="@value.ToString()">@CapsuleerProvisioningRules.Description(value)</option>
                }
            </select></label>
            <button class="secondary" @onclick="Load">Refresh</button>
        </div>
        <p class="muted">@Filtered.Count matching systems. Eligibility changes never remove an established community.</p>
        <div class="scroll"><table><thead><tr><th>System</th><th>Bot access</th><th>Eligibility</th><th>Settings</th><th>Community</th><th>Home / destination</th></tr></thead><tbody>
            @foreach (var system in Filtered.Skip(Page * PageSize).Take(PageSize))
            {
                <tr><td>@Name(system.SystemId) (@system.SystemId)</td>
                    <td>@CapsuleerPopulationRules.Describe(CapsuleerPopulationRules.WorkAccess(snapshot.Policy, system.SystemId,
                            Catalog.Systems.GetValueOrDefault(system.SystemId)?.RegionId ?? 0))</td>
                    <td>@CapsuleerProvisioningRules.Description(system.Eligibility)</td>
                    <td>@(system.CurrentPolicy ? "Current" : "Pending preparation")</td>
                    <td>@(system.Provisioned ? "Established" : "Not provisioned")</td><td>@system.HomeStationId / @system.DestinationStationId</td></tr>
            }
        </tbody></table></div>
        <div class="toolbar">
            <button class="secondary" disabled="@(Page == 0)" @onclick="Previous">Previous</button>
            <span>Page @(Page + 1)</span>
            <button class="secondary" disabled="@((Page + 1) * PageSize >= Filtered.Count)" @onclick="Next">Next</button>
        </div>
    </section>
}
