@page "/population"
@attribute [Authorize(Policy = AdministratorAccounts.Policy)]
@using Eden.Gameplay.Capsuleers
@inject AdministrationOperations Operations
@inject AuthenticationStateProvider Authentication
@inject Eden.World.Catalog.CatalogProvider Catalog
<PageTitle>Population · Eden</PageTitle>
<h1>Autonomous population</h1>
<button class="secondary" @onclick="Load">Refresh population</button>
<p class="muted">Pilots run only in systems with a connected player. When the last player leaves, pilots pause and retain their ships,
    possessions and pending work. Gate visitor preparation requires players on both sides of the gate.</p>
@if (Error is not null)
{
    <p class="error" role="alert">@Error</p>
}
@if (Snapshot is { } snapshot)
{
    <section class="card">
        <h2>Active population settings</h2>
        <p>Simulated pilots: @(snapshot.Policy.Enabled ? "On" : "Off") · Miners: @(snapshot.Policy.Miners ? "On" : "Off") ·
            Station traffic: @snapshot.Policy.TrafficMultiplier× · Visitors per watched gate: @snapshot.Policy.GateVisitors</p>
        <p class="muted">Traffic and visitor limits are separate. They do not guarantee every saved pilot is in your current system.</p>
    </section>
    <section class="card">
        <h2>Coverage</h2>
        <dl class="readings">
            <div><dt>Prepared systems · current settings</dt><dd>@snapshot.Population.PreparedSystems</dd></div>
            <div><dt>Eligible prepared systems</dt><dd>@snapshot.Population.PreparedEligibleSystems</dd></div>
            <div><dt>Saved communities</dt><dd>@snapshot.Population.Communities</dd></div>
            <div><dt>Saved pilots</dt><dd>@snapshot.Population.Agents</dd></div>
            <div><dt>Enabled pilots</dt><dd>@snapshot.Population.EnabledAgents</dd></div>
            <div><dt>Paused pilots</dt><dd>@snapshot.Population.PausedAgents</dd></div>
            <div><dt>Scheduled pilots</dt><dd>@snapshot.Runtime.ScheduledAgents</dd></div>
            <div><dt>Pilots in watched systems</dt><dd>@snapshot.MaterializedPilots</dd></div>
        </dl>
        <p class="muted">Saved totals include dormant pilots. Founders are prepared on demand in occupied systems.</p>
    </section>
    <section class="card">
        <h2>Waiting pilots</h2>
        @if (snapshot.Runtime.Blocked.Count == 0)
        {
            <p class="muted">No waiting reasons have been reported in this process.</p>
        }
        @foreach (var reason in snapshot.Runtime.Blocked)
        {
            <p>@reason.Agents · @reason.Reason</p>
        }
    </section>
    <section class="card">
        <h2>System eligibility records</h2>
        <div class="toolbar">
            <label>System name or ID<input @bind="Search" @bind:after="ResetPage" /></label>
            <label>Eligibility<select @bind="Reason" @bind:after="ResetPage">
                <option value="">All systems</option>
                @foreach (var value in Enum.GetValues<CapsuleerEligibility>())
                {
                    <option value="@value.ToString()">@CapsuleerProvisioningRules.Description(value)</option>
                }
            </select></label>
            <button class="secondary" @onclick="Load">Refresh</button>
        </div>
        <p class="muted">@Filtered.Count matching systems. Eligibility changes never remove an established community.</p>
        <div class="scroll"><table><thead><tr><th>System</th><th>Eligibility</th><th>Settings</th><th>Community</th><th>Home / destination</th></tr></thead><tbody>
            @foreach (var system in Filtered.Skip(Page * PageSize).Take(PageSize))
            {
                <tr><td>@Name(system.SystemId) (@system.SystemId)</td><td>@CapsuleerProvisioningRules.Description(system.Eligibility)</td>
                    <td>@(system.CurrentPolicy ? "Current" : "Pending preparation")</td>
                    <td>@(system.Provisioned ? "Established" : "Not provisioned")</td><td>@system.HomeStationId / @system.DestinationStationId</td></tr>
            }
        </tbody></table></div>
        <div class="toolbar">
            <button class="secondary" disabled="@(Page == 0)" @onclick="Previous">Previous</button>
            <span>Page @(Page + 1)</span>
            <button class="secondary" disabled="@((Page + 1) * PageSize >= Filtered.Count)" @onclick="Next">Next</button>
        </div>
    </section>
}
