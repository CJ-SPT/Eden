@page "/population"
@attribute [Authorize(Policy = AdministratorAccounts.Policy)]
@using Eden.Gameplay.Capsuleers
@inject AdministrationOperations Operations
@inject AuthenticationStateProvider Authentication
@inject Eden.World.Catalog.CatalogProvider Catalog
<PageTitle>Population · Eden</PageTitle>
<h1>Autonomous population</h1>
<button class="secondary" @onclick="Load">Refresh population</button>
<p class="muted">NPC regions activate when entered, starting with your current system. The remaining systems in that region
    prepare in the background. Untouched regions stay dormant. Gate visitors are prepared when gates are watched.
    Excess pilots are paused and retained for reuse, including their ships, possessions and progress.</p>
<p class="muted">Distant pilots update about once a minute and may fall behind under heavy load.
    Visiting more regions preserves their residents without keeping every pilot in detailed simulation.</p>
@if (Error is not null)
{
    <p class="error" role="alert">@Error</p>
}
@if (Snapshot is { } snapshot)
{
    <section class="card">
        <h2>Active population settings</h2>
        <p>Simulated pilots: @(snapshot.Policy.Enabled ? "On" : "Off") · Miners: @(snapshot.Policy.Miners ? "On" : "Off") ·
            Station traffic: @snapshot.Policy.TrafficMultiplier× · Visitors per watched gate: @snapshot.Policy.GateVisitors</p>
        <p class="muted">Traffic and visitor limits are separate. They do not guarantee every saved pilot is in your current system.</p>
    </section>
    <section class="card">
        <h2>Coverage</h2>
        <dl class="readings">
            <div><dt>Prepared systems · current settings</dt><dd>@snapshot.Population.PreparedSystems</dd></div>
            <div><dt>Eligible prepared systems</dt><dd>@snapshot.Population.PreparedEligibleSystems</dd></div>
            <div><dt>Saved communities</dt><dd>@snapshot.Population.Communities</dd></div>
            <div><dt>Saved pilots</dt><dd>@snapshot.Population.Agents</dd></div>
            <div><dt>Enabled pilots</dt><dd>@snapshot.Population.EnabledAgents</dd></div>
            <div><dt>Paused pilots</dt><dd>@snapshot.Population.PausedAgents</dd></div>
            <div><dt>Scheduled pilots</dt><dd>@snapshot.Runtime.ScheduledAgents</dd></div>
            <div><dt>Coarse pilots / systems</dt><dd>@snapshot.Runtime.CoarseAgents / @snapshot.Runtime.CoarseSystems</dd></div>
            <div><dt>Combat-pinned systems</dt><dd>@snapshot.Runtime.CombatPinnedSystems</dd></div>
            <div><dt>Systems awaiting preparation</dt><dd>@snapshot.Runtime.PendingPreparationSystems</dd></div>
            <div><dt>Oldest remote update age (seconds)</dt><dd>@TimeSpan.FromTicks(snapshot.Runtime.RemoteAgeTicks).TotalSeconds.ToString("F1")</dd></div>
            <div><dt>Background budget overruns</dt><dd>@snapshot.Runtime.BackgroundBudgetOverruns</dd></div>
            <div><dt>Pilots in watched systems</dt><dd>@snapshot.MaterializedPilots</dd></div>
        </dl>
        <p class="muted">Enabled pilots may travel outside watched systems. Scheduled pilots currently have simulation work enrolled.
            Pilots in watched systems include docked guests. Saved totals include paused pilots.</p>
        <p class="muted">@snapshot.Population.RegisteredSystems saved system records are retained, including earlier settings.
            Saved prepared totals can include dormant regions. Preparation refreshes in entered regions;
            deferred systems retry on a visit or after re-entry following restart.</p>
    </section>
    <section class="card">
        <h2>Recent system returns</h2>
        <p class="muted">The latest return with skipped progress for each of up to 32 systems, since startup.
            Longest skipped interval describes one bot's overdue work on that visit. Saved assets and already-paid work are preserved.</p>
        @if (snapshot.Runtime.RecentReturns.Count == 0)
        {
            <p class="muted">No remote progress has been skipped on a system return since startup.</p>
        }
        else
        {
            <div class="scroll"><table><thead><tr><th>System</th><th>Sampled (UTC)</th><th>Affected bots</th><th>Longest skipped interval</th></tr></thead><tbody>
                @foreach (var returned in snapshot.Runtime.RecentReturns)
                {
                    <tr><td>@Name(returned.SystemId) (@returned.SystemId)</td>
                        <td>@returned.SampledAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@returned.Bots</td>
                        <td>@TimeSpan.FromTicks(returned.MaximumSkippedTicks).TotalSeconds.ToString("N1") s</td></tr>
                }
            </tbody></table></div>
        }
    </section>
    <section class="card">
        <h2>Waiting pilots</h2>
        @if (snapshot.Runtime.Blocked.Count == 0)
        {
            <p class="muted">No waiting reasons have been reported in this process.</p>
        }
        @foreach (var reason in snapshot.Runtime.Blocked)
        {
            <p>@reason.Agents · @reason.Reason</p>
        }
    </section>
    <section class="card">
        <h2>System eligibility records</h2>
        <div class="toolbar">
            <label>System name or ID<input @bind="Search" @bind:after="ResetPage" /></label>
            <label>Eligibility<select @bind="Reason" @bind:after="ResetPage">
                <option value="">All systems</option>
                @foreach (var value in Enum.GetValues<CapsuleerEligibility>())
                {
                    <option value="@value.ToString()">@CapsuleerProvisioningRules.Description(value)</option>
                }
            </select></label>
            <button class="secondary" @onclick="Load">Refresh</button>
        </div>
        <p class="muted">@Filtered.Count matching systems. Eligibility changes never remove an established community.</p>
        <div class="scroll"><table><thead><tr><th>System</th><th>Eligibility</th><th>Settings</th><th>Community</th><th>Home / destination</th></tr></thead><tbody>
            @foreach (var system in Filtered.Skip(Page * PageSize).Take(PageSize))
            {
                <tr><td>@Name(system.SystemId) (@system.SystemId)</td><td>@CapsuleerProvisioningRules.Description(system.Eligibility)</td>
                    <td>@(system.CurrentPolicy ? "Current" : "Pending preparation")</td>
                    <td>@(system.Provisioned ? "Established" : "Not provisioned")</td><td>@system.HomeStationId / @system.DestinationStationId</td></tr>
            }
        </tbody></table></div>
        <div class="toolbar">
            <button class="secondary" disabled="@(Page == 0)" @onclick="Previous">Previous</button>
            <span>Page @(Page + 1)</span>
            <button class="secondary" disabled="@((Page + 1) * PageSize >= Filtered.Count)" @onclick="Next">Next</button>
        </div>
    </section>
}
