<section class="card">
    <h2>Economy &amp; market</h2>
    <label>Market preset
        <InputSelect @bind-Value="Form.MarketPreset">
            <option value="@MarketPreset.Standard">Standard · live order snapshot</option>
            <option value="@MarketPreset.Progressive">Progressive · production unlocks</option>
            <option value="@MarketPreset.Testing">Testing · broad supply at a fixed price</option>
            <option value="@MarketPreset.NpcOnly">NPC only · catalog corporation offers</option>
            <option value="@MarketPreset.Custom">Custom · individual supply settings</option>
        </InputSelect>
    </label>
    <p class="muted">Changes apply after restart. Existing balances, goods and player orders are preserved.</p>
    @if (Form.StandardMarket)
    {
        @if (Snapshot?.CapturedAt is DateTimeOffset captured)
        {
            <p role="status">Snapshot: @captured.ToString("u") · @Snapshot.Orders.ToString("N0") orders
                across @Snapshot.Regions regions · @Snapshot.Excluded.ToString("N0") excluded orders.</p>
        }
        else
        {
            <p role="status">@(Snapshot?.Error ?? "No live order snapshot is installed.")</p>
        }
        <p>Mirrors public live-game orders at their original supported stations, with captured prices and quantities.
            Orders deplete as you trade and expire on their original deadlines. A new import replaces snapshot stock after restart.</p>
        <p class="muted">Requires an imported live order snapshot. Newer items and stations absent from this client,
            private orders and player structures are excluded. Live player identities are replaced by local station corporations.</p>
    }
    else if (Form.MarketPreset == MarketPreset.Progressive)
    {
        <p>Build products to unlock regional supply. Regional hubs carry NPC goods, with starter equipment available immediately.</p>
    }
    else if (Form.MarketPreset == MarketPreset.Testing)
    {
        <p>Renewable development stock at one configurable price, for eligible published market items.</p>
    }
    else if (Form.MarketPreset == MarketPreset.NpcOnly)
    {
        <p>Station corporations offer their catalog goods. Player production and trading supply the rest.</p>
    }
    @if (Form.MarketPreset == MarketPreset.Custom)
    {
        <fieldset>
            <legend>Custom market supply</legend>
            <label><InputCheckbox @bind-Value="Form.StandardMarket" />Mirror imported live orders</label>
            <label><InputCheckbox @bind-Value="Form.ProgressiveMarkets" />Progressive regional markets</label>
            <label><InputCheckbox @bind-Value="Form.TestingMarket" />Testing market</label>
            <label><InputCheckbox @bind-Value="Form.RegionalHubSupply" />Full NPC sell assortment at regional hubs</label>
            <label><InputCheckbox @bind-Value="Form.BeginnerMarketSupply" />Starter supply in progressive markets</label>
            <p class="muted">Live orders require progressive and testing markets to be off. Progressive supply takes priority
                over testing supply when both are enabled. Hub and starter supplements do not apply to live orders.</p>
        </fieldset>
    }
    @if (!Form.StandardMarket)
    {
        @if (Form.ProgressiveMarkets || !Form.TestingMarket)
        {
            <label>NPC stock per order<InputNumber @bind-Value="Form.InstitutionalStock" min="1" max="1000000" /></label>
        }
        @if (Form.TestingMarket && !Form.ProgressiveMarkets)
        {
            <label>Testing stock per order<InputNumber @bind-Value="Form.TestingStock" min="1" max="1000000000" /></label>
            <label>Testing price (ISK)<InputNumber @bind-Value="Form.TestingPriceIsk" min="0.01" step="0.01" /></label>
        }
    }
    <h3>Economy options</h3>
    <label><InputCheckbox @bind-Value="Form.EmpireLpDatacores" />Empire LP-store datacores</label>
    <p class="muted">Extend ordinary empire LP stores with their militia datacore offers.</p>
    <label><InputCheckbox @bind-Value="Form.SimulatedMarketHistory" />Simulated reference market history</label>
    <p class="muted">Generate reference trades from captured prices. This is separate from imported order books.</p>
    <label><InputCheckbox @bind-Value="Form.ServiceCosts" />Charge service costs</label>
    @if (Form.ServiceCosts)
    {
        <label>Default manufacturing index
            <InputNumber @bind-Value="Form.ManufacturingIndex" min="0" max="1" step="0.001" />
        </label>
        <p class="muted">0.01 means 1%. Service costs require adjusted material prices in Advanced settings.</p>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public SettingsForm Form { get; set; } = default!;

    [Parameter]
    public AdminMarketSnapshot? Snapshot { get; set; }
}
