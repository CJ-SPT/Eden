@page "/performance"
@attribute [Authorize(Policy = AdministratorAccounts.Policy)]
@implements IAsyncDisposable
@inject AdministrationOperations Operations
@inject AuthenticationStateProvider Authentication
<PageTitle>Performance · Eden</PageTitle>
<div class="performance-hero">
    <div>
        <h1>Server performance</h1>
        <p class="muted">Pilot session timing, process resources and world health.</p>
    </div>
    @if (Snapshot is not null)
    {
        <span class="sample-status">Refreshes every 2 seconds</span>
    }
</div>
@if (Error is not null)
{
    <p class="error" role="alert">@Error</p>
    <p class="muted">Updates stopped. Reload this page to reconnect or sign in again.</p>
}
@if (Snapshot is { } snapshot)
{
    <PerformanceSummary Snapshot="snapshot" />
}
