@page "/performance"
@attribute [Authorize(Policy = AdministratorAccounts.Policy)]
@implements IAsyncDisposable
@inject AdministrationOperations Operations
@inject AuthenticationStateProvider Authentication
<PageTitle>Performance · Eden</PageTitle>
<h1>Server performance</h1>
<p class="muted">Live diagnostics for the Eden server process. Refreshes every two seconds while this page is open.</p>
@if (Error is not null)
{
    <p class="error" role="alert">@Error</p>
    <p class="muted">Updates stopped. Reload this page to reconnect or sign in again.</p>
}
@if (Snapshot is { } snapshot)
{
    <PerformanceSummary Snapshot="snapshot" />
}
