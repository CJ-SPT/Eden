<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <base href="/" />
    <title>Eden · Local administration</title>
    <style>
        :root {
            color-scheme: dark;
            font-family: "Segoe UI", sans-serif;
            --background: #0d141e;
            --surface: #16212f;
            --surface-raised: #203044;
            --border: #384b62;
            --text: #e4edf7;
            --muted: #a9bbcf;
            --accent: #85d9c8;
            color: var(--text);
            background: var(--background);
        }
        * { box-sizing: border-box; }
        body { margin: 0; }
        header { background: #111b28; border-bottom: 1px solid var(--border); padding: 20px 32px; display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }
        header strong { font-size: 21px; letter-spacing: 2px; }
        header small { color: var(--muted); }
        nav { display: flex; gap: 22px; margin-left: auto; align-items: center; flex-wrap: wrap; }
        nav a { color: var(--muted); text-decoration: none; padding: 8px 0; }
        nav a.active { color: var(--text); border-bottom: 2px solid var(--accent); }
        main { max-width: 1480px; margin: 32px auto; padding: 0 24px 60px; }
        h1 { font-size: 28px; margin: 0 0 8px; }
        h2 { font-size: 19px; margin-top: 0; }
        h3 { font-size: 16px; }
        p { line-height: 1.55; }
        a { color: var(--accent); }
        .muted { color: var(--muted); font-size: 14px; }
        .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 24px; margin: 20px 0; min-width: 0; }
        .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
        .grid .card { margin: 0; }
        .toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin: 16px 0; }
        .badge { display: inline-block; color: #ffe0a3; background: #42351e; padding: 7px 12px; border-radius: 20px; font-size: 13px; }
        .notice { background: #18372f; border-left: 4px solid var(--accent); padding: 14px 18px; border-radius: 5px; }
        .error, .validation-message, .validation-errors { color: #ffabb4; }
        label { display: block; margin: 14px 0; font-size: 14px; }
        input:not([type=checkbox]), select, textarea { display: block; width: 100%; padding: 9px 11px; margin-top: 6px; border: 1px solid var(--border); border-radius: 5px; font: inherit; color: var(--text); background: var(--background); }
        input[type=checkbox] { margin-right: 8px; accent-color: var(--accent); }
        input::placeholder, textarea::placeholder { color: var(--muted); }
        button { background: #85d9c8; color: #102c28; border: 0; padding: 10px 17px; border-radius: 6px; cursor: pointer; font: inherit; }
        button.secondary { background: var(--surface-raised); color: var(--text); }
        button:hover:not(:disabled) { filter: brightness(1.12); }
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
        button:disabled { opacity: .5; cursor: default; }
        .toolbar input, .toolbar select { width: auto; min-width: 180px; margin: 0; }
        table { border-collapse: collapse; width: 100%; font-size: 14px; }
        td, th { text-align: left; padding: 11px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
        th { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .5px; }
        code, pre { font-family: Consolas, monospace; font-size: 12px; overflow-wrap: anywhere; white-space: pre-wrap; }
        .scroll { overflow-x: auto; }
        details { margin: 10px 0; }
        summary { cursor: pointer; color: var(--accent); }
        .tree { border-left: 2px solid var(--border); margin-left: 10px; padding-left: 14px; }
        .login { max-width: 420px; margin: 80px auto; }
        fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
        .skill-workspace { display: grid; grid-template-columns: 310px minmax(0, 1fr); gap: 20px; align-items: start; }
        .skill-workspace .card { margin-top: 0; }
        .skill-list { display: grid; gap: 6px; max-height: 650px; overflow-y: auto; }
        .skill-choice { width: 100%; text-align: left; background: var(--background); color: var(--text); border: 1px solid var(--border); }
        .skill-choice small { color: var(--muted); }
        .skill-choice.selected { border-color: var(--accent); background: #18372f; }
        .skill-input-row { display: grid; grid-template-columns: minmax(0, 1fr) 110px auto; gap: 16px; align-items: start; padding: 12px 0; border-bottom: 1px solid var(--border); }
        .skill-editor label { margin: 8px 0; }
        .skill-editor .grid { gap: 8px 20px; align-items: start; }
        .skill-tabs { display: flex; gap: 8px; flex-wrap: wrap; padding-bottom: 16px; border-bottom: 1px solid var(--border); }
        .skill-section { padding: 18px 0; border-bottom: 1px solid var(--border); }
        .skill-section h3 { margin: 0 0 10px; }
        .skill-lookup { min-width: 0; }
        .skill-lookup select { max-width: 100%; min-width: 0; text-overflow: ellipsis; }
        .skill-search { margin: 6px 0; font-size: 13px; }
        .skill-search-results { display: grid; gap: 5px; max-height: 260px; overflow-y: auto; margin: 10px 0; }
        .skill-search-results button { width: 100%; text-align: left; overflow-wrap: anywhere; }
        .skill-description, .skill-effect-card small { overflow-wrap: anywhere; line-height: 1.6; }
        .skill-effect-card { padding: 16px; margin: 16px 0; border: 1px solid var(--border); border-radius: 8px; min-width: 0; }
        .skill-effect-heading { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: start; }
        .skill-control-row > .skill-lookup { display: contents; }
        .skill-editor .skill-control-row label { margin: 0; }
        .skill-control-row > .skill-lookup > label { grid-column: 1; grid-row: 1; }
        .skill-control-row > .skill-lookup > :not(label) { grid-column: 1; }
        .skill-input-row > label { grid-column: 2; grid-row: 1; }
        .skill-input-row > button { grid-column: 3; grid-row: 1; }
        .skill-effect-heading > button { grid-column: 2; grid-row: 1; }
        .skill-control-row > button { align-self: end; min-height: 42px; }
        .skill-control-row input, .skill-control-row select { height: 42px; }
        .skill-bonus-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
        .skill-section .skill-bonus-heading h3 { margin: 0; }
        .skill-bonus-value { max-width: 260px; }
        .skill-section > button { margin-top: 12px; }
        .skill-recipe, .skill-preview { padding: 16px; background: var(--background); border-radius: 8px; }
        .skill-recipe p, .skill-preview p { margin: 8px 0 12px; }
        .skill-preview { margin: 16px 0; }
        .skill-preview caption { text-align: left; color: var(--muted); }
        .skill-save-bar { position: sticky; bottom: 0; padding: 14px 0; margin-bottom: 0; background: var(--surface); border-top: 1px solid var(--border); }
        .skill-history { display: flex; gap: 16px; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); }
        .danger { background: #692d3b; color: #ffe0e5; }
        @@media (max-width: 900px) {
            .skill-workspace { grid-template-columns: 1fr; }
            .skill-input-row, .skill-effect-heading { grid-template-columns: 1fr; }
            .skill-control-row > label, .skill-control-row > button, .skill-control-row > .skill-lookup > label {
                grid-column: 1; grid-row: auto;
            }
            .skill-control-row > button { justify-self: start; }
        }
        @@media (max-width: 450px) {
            .skill-preview { padding: 12px; }
            .skill-preview table { table-layout: fixed; }
            .skill-preview th, .skill-preview td { padding: 8px 2px; font-size: 11px; letter-spacing: 0; }
        }
        .performance-grid { margin-top: 20px; }
        .metric { font-size: 32px; font-weight: 600; margin: 12px 0; font-variant-numeric: tabular-nums; }
        .readings { display: flex; flex-wrap: wrap; gap: 20px 36px; margin: 0; }
        .readings dt { color: var(--muted); font-size: 14px; }
        .readings dd { margin: 8px 0 0; font-size: 20px; font-variant-numeric: tabular-nums; }
        #blazor-error-ui { display: none; color: #ffe0a3; background: #42351e; padding: 15px; position: fixed; bottom: 0; width: 100%; }
        @@media (max-width: 750px) { .grid { grid-template-columns: 1fr; } header { padding: 16px 24px; } nav { margin-left: 0; } }
    </style>
    <HeadOutlet />
</head>
<body>
    <AdministrationRoutes @rendermode="InteractiveServer" />
    <div id="blazor-error-ui">The administration connection needs to reload. <a href="" class="reload">Reload</a></div>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
