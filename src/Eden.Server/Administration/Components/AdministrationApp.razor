<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>Eden · Local administration</title>
    <style>
        :root { font-family: "Segoe UI", sans-serif; color: #263448; background: #f3f6fa; }
        * { box-sizing: border-box; }
        body { margin: 0; }
        header { background: #172738; color: white; padding: 20px 32px; display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }
        header strong { font-size: 21px; letter-spacing: 2px; }
        header small { color: #b8c8db; }
        nav { display: flex; gap: 22px; margin-left: auto; align-items: center; }
        nav a { color: #dce8f6; text-decoration: none; padding: 8px 0; }
        nav a.active { color: white; border-bottom: 2px solid #70c7b4; }
        main { max-width: 1240px; margin: 32px auto; padding: 0 24px 60px; }
        h1 { font-size: 28px; margin: 0 0 8px; }
        h2 { font-size: 19px; margin-top: 0; }
        h3 { font-size: 16px; }
        p { line-height: 1.55; }
        a { color: #236b77; }
        .muted { color: #627184; font-size: 14px; }
        .card { background: white; border: 1px solid #dce3eb; border-radius: 12px; padding: 24px; margin: 20px 0; }
        .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
        .grid .card { margin: 0; }
        .toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin: 16px 0; }
        .badge { display: inline-block; color: #845900; background: #fff2cc; padding: 7px 12px; border-radius: 20px; font-size: 13px; }
        .notice { background: #e7f5ef; border-left: 4px solid #2d8b68; padding: 14px 18px; border-radius: 5px; }
        .error, .validation-message, .validation-errors { color: #9f2e36; }
        label { display: block; margin: 14px 0; font-size: 14px; }
        input:not([type=checkbox]), select { display: block; width: 100%; padding: 9px 11px; margin-top: 6px; border: 1px solid #bdc9d7; border-radius: 5px; font: inherit; background: white; }
        input[type=checkbox] { margin-right: 8px; accent-color: #247f72; }
        button { background: #246e70; color: white; border: 0; padding: 10px 17px; border-radius: 6px; cursor: pointer; font: inherit; }
        button.secondary { background: #e9eef4; color: #2d425b; }
        button:disabled { opacity: .5; cursor: default; }
        .toolbar input, .toolbar select { width: auto; min-width: 180px; margin: 0; }
        table { border-collapse: collapse; width: 100%; font-size: 14px; }
        td, th { text-align: left; padding: 11px 10px; border-bottom: 1px solid #e4e9ef; vertical-align: top; }
        th { color: #596b81; font-size: 12px; text-transform: uppercase; letter-spacing: .5px; }
        code, pre { font-family: Consolas, monospace; font-size: 12px; overflow-wrap: anywhere; white-space: pre-wrap; }
        .scroll { overflow-x: auto; }
        details { margin: 10px 0; }
        summary { cursor: pointer; color: #236b77; }
        .tree { border-left: 2px solid #e1e8f0; margin-left: 10px; padding-left: 14px; }
        .login { max-width: 420px; margin: 80px auto; }
        #blazor-error-ui { display: none; background: #fff2cc; padding: 15px; position: fixed; bottom: 0; width: 100%; }
        @@media (max-width: 750px) { .grid { grid-template-columns: 1fr; } header { padding: 16px 24px; } nav { margin-left: 0; } }
    </style>
    <HeadOutlet />
</head>
<body>
    <AdministrationRoutes @rendermode="InteractiveServer" />
    <div id="blazor-error-ui">The administration connection needs to reload. <a href="" class="reload">Reload</a></div>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
