@page "/"
@attribute [Authorize(Policy = AdministratorAccounts.Policy)]
@inject AdministrationOperations Operations
@inject AuthenticationStateProvider Authentication
<PageTitle>Settings · Eden</PageTitle>
<div class="settings-hero">
    <div>
        <h1>World settings</h1>
        <p class="muted">Edit the draft, then save it for the next server restart.</p>
    </div>
    <ConfigurationStatus State="State" />
</div>
@if (State is null)
{
    @if (Error is not null)
    {
        <p class="error" role="alert">@Error</p>
    }
    else
    {
        <p>Loading settings…</p>
    }
}
else
{
    <div class="settings-workspace">
        <nav class="settings-nav" aria-label="World settings categories">
            @foreach (var (group, categories) in Categories)
            {
                <div class="settings-nav-group" role="group" aria-label="@group">
                    <p aria-hidden="true">@group</p>
                    @foreach (var (activity, label) in categories)
                    {
                        <button type="button" class="secondary" aria-pressed="@(Workspace.Activity == activity ? "true" : "false")"
                                aria-controls="@($"settings-{activity}")" @onclick="() => Workspace.Activity = activity">@label</button>
                    }
                </div>
            }
        </nav>
        <div class="settings-content">
            <EditForm @key="Context" EditContext="Context" OnValidSubmit="Save" OnInvalidSubmit="Invalid"
                      FormName="world-settings" id="world-settings" novalidate>
                <DataAnnotationsValidator />
                <fieldset disabled="@Busy">
                    <section id="settings-Gathering" class="settings-panel" aria-labelledby="heading-Gathering"
                             hidden="@(Workspace.Activity != SettingsActivity.Gathering)">
                        <div class="settings-panel-heading">
                            <h2 id="heading-Gathering">Gathering</h2>
                            <p class="muted">Tune player harvesting, mining holds and asteroid belt renewal.</p>
                        </div>
                        <section class="card settings-group">
                            <h3>Harvesting yield</h3>
                            <p class="muted">Cargo limits, finite deposits, critical yield and residue still apply.</p>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="Ore mining yield" @bind-Value="Form.OreYieldMultiplier"
                                    Description="Scales extraction after normal bonuses."
                                    ExampleAmount="100" ExampleUnit="m³ per cycle" Reward="false"
                                    Speed="false" Efficiency="false" />
                                <MultiplierControl Label="Ice harvesting yield" @bind-Value="Form.IceYieldMultiplier"
                                    Description="Scales blocks per completed cycle; interrupted cycles produce nothing."
                                    ExampleAmount="1" ExampleUnit="blocks per cycle" Reward="false"
                                    Speed="false" Efficiency="false" />
                                <MultiplierControl Label="Gas harvesting yield" @bind-Value="Form.GasYieldMultiplier"
                                    Description="Scales extraction after normal bonuses."
                                    ExampleAmount="100" ExampleUnit="m³ per cycle" Reward="false"
                                    Speed="false" Efficiency="false" />
                            </div>
                        </section>
                        <section class="card settings-group">
                            <h3>Mining hold capacity</h3>
                            <p class="muted">Capacity scales after ship and skill bonuses. If a hold is over capacity, unload it to free space.</p>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="General mining hold capacity" @bind-Value="Form.GeneralMiningHoldMultiplier"
                                    Description="Applies to the general mining hold, including when it carries ice or gas."
                                    ExampleAmount="5000" ExampleUnit="m³" />
                                <MultiplierControl Label="Ice hold capacity" @bind-Value="Form.IceHoldMultiplier"
                                    Description="Applies to dedicated ice holds."
                                    ExampleAmount="10000" ExampleUnit="m³" />
                                <MultiplierControl Label="Gas hold capacity" @bind-Value="Form.GasHoldMultiplier"
                                    Description="Applies to dedicated gas holds."
                                    ExampleAmount="10000" ExampleUnit="m³" />
                            </div>
                        </section>
                        <section class="card settings-group">
                            <h3>Asteroid belt renewal</h3>
                            <div class="settings-fields">
                                <SettingField Label="Renew asteroid belts"
                                              Help="Allow depleted asteroid belts to renew on the configured schedule.">
                                    <Control Context="field">
                                        <InputCheckbox id="@field.Input" @bind-Value="Form.RenewBelts" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                                <SettingField Label="Renewal hour (UTC)"
                                              Help="Hour of the day for new belt renewal deadlines. Enter 0 for midnight UTC. Saved deadlines keep their scheduled time.">
                                    <Control Context="field">
                                        <InputNumber id="@field.Input" @bind-Value="Form.RenewalHourUtc" min="0" max="23" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                            </div>
                        </section>
                    </section>
                    <section id="settings-Rewards" class="settings-panel" aria-labelledby="heading-Rewards"
                             hidden="@(Workspace.Activity != SettingsActivity.Rewards)">
                        <div class="settings-panel-heading">
                            <h2 id="heading-Rewards">Rewards</h2>
                            <p class="muted">Set the ISK, loyalty points and standings pilots earn from NPC combat and missions.</p>
                        </div>
                        <section class="card settings-group">
                            <h3>NPC bounties</h3>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="NPC bounty ISK" @bind-Value="Form.BountyMultiplier"
                                    Description="Applies before corporation tax and also scales NPC kill SP."
                                    ExampleAmount="100000" ExampleUnit="ISK" Reward="true"
                                    Speed="false" Efficiency="false" />
                            </div>
                        </section>
                        <section class="card settings-group">
                            <h3>Mission rewards</h3>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="Mission ISK" @bind-Value="Form.MissionIskMultiplier"
                                    Description="New mission offers only; saved rewards retain their terms."
                                    ExampleAmount="100000" ExampleUnit="ISK" Reward="true"
                                    Speed="false" Efficiency="false" />
                                <MultiplierControl Label="Mission loyalty points" @bind-Value="Form.MissionLpMultiplier"
                                    Description="New mission offers only; fractional points are rounded down."
                                    ExampleAmount="1000" ExampleUnit="LP" Reward="true"
                                    Speed="false" Efficiency="false" />
                                <MultiplierControl Label="Positive mission standings" @bind-Value="Form.MissionStandingMultiplier"
                                    Description="Scales positive gain fractions, capped at 100%; penalties are unchanged."
                                    ExampleAmount="1" ExampleUnit="% gain fraction" Reward="true"
                                    Speed="false" Efficiency="true" />
                            </div>
                        </section>
                    </section>
                    <section id="settings-Progression" class="settings-panel" aria-labelledby="heading-Progression"
                             hidden="@(Workspace.Activity != SettingsActivity.Progression)">
                        <div class="settings-panel-heading">
                            <h2 id="heading-Progression">Progression</h2>
                            <p class="muted">Set activity-based skill point rates and what newly created pilots receive.</p>
                        </div>
                        <section class="settings-group">
                            <h3>Activity skill points</h3>
                            <ProgressionControls Form="Form" ActiveSettings="State.Active.Draft.Settings" Changed="StateHasChanged"
                                EditRewards="() => Workspace.Activity = SettingsActivity.Rewards"
                                EditGathering="() => Workspace.Activity = SettingsActivity.Gathering" />
                        </section>
                        <section class="card settings-group">
                            <h3>New pilot grants</h3>
                            <p class="muted">Training speed and skill requirements are unchanged.</p>
                            <div class="settings-fields">
                                <SettingField Label="Grant catalog starting skills to new pilots"
                                              Help="Gives newly created pilots the starting skills defined in the catalog.">
                                    <Control Context="field">
                                        <InputCheckbox id="@field.Input" @bind-Value="Form.StartingSkills" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                                <SettingField Label="Grant civilian starting equipment to new pilots"
                                              Help="Gives newly created pilots a civilian miner and weapon.">
                                    <Control Context="field">
                                        <InputCheckbox id="@field.Input" @bind-Value="Form.StartingEquipment" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                                <SettingField Label="Initial wallet grants for new pilots"
                                              Help="Pays the configured starting ISK amount to pilots when they are created.">
                                    <Control Context="field">
                                        <InputCheckbox id="@field.Input" @bind-Value="Form.TestingGrants" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                                <SettingField Label="Initial wallet grant (ISK)"
                                              Help="ISK paid at character creation when initial wallet grants are enabled.">
                                    <Control Context="field">
                                        <InputNumber id="@field.Input" @bind-Value="Form.GrantIsk" min="0" step="0.01" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                            </div>
                        </section>
                    </section>
                    <section id="settings-Fitting" class="settings-panel" aria-labelledby="heading-Fitting"
                             hidden="@(Workspace.Activity != SettingsActivity.Fitting)">
                        <div class="settings-panel-heading">
                            <h2 id="heading-Fitting">Fitting</h2>
                            <p class="muted">Scale ship budgets after skills and fitted bonuses.</p>
                        </div>
                        <section class="card settings-group">
                            <h3>Module and rig budgets</h3>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="Ship CPU output" @bind-Value="Form.ShipCpuMultiplier"
                                    Description="Changes the CPU available to bring modules online."
                                    ExampleAmount="180" ExampleUnit="tf" />
                                <MultiplierControl Label="Ship power grid output" @bind-Value="Form.ShipPowerGridMultiplier"
                                    Description="Changes the power grid available to bring modules online."
                                    ExampleAmount="50" ExampleUnit="MW" />
                                <MultiplierControl Label="Rig calibration" @bind-Value="Form.ShipCalibrationMultiplier"
                                    Description="Changes how much calibration you can spend on rigs in the hull's available rig slots."
                                    ExampleAmount="400" ExampleUnit="calibration points" />
                            </div>
                        </section>
                        <section class="card settings-group">
                            <h3>Drones</h3>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="Drone bandwidth" @bind-Value="Form.ShipDroneBandwidthMultiplier"
                                    Description="Changes how much bandwidth you can spend on deployed drones. The hull still needs a drone bay."
                                    ExampleAmount="25" ExampleUnit="Mbit/s" />
                            </div>
                        </section>
                    </section>
                    <section id="settings-Travel" class="settings-panel" aria-labelledby="heading-Travel"
                             hidden="@(Workspace.Activity != SettingsActivity.Travel)">
                        <div class="settings-panel-heading">
                            <h2 id="heading-Travel">Travel</h2>
                            <p class="muted">Set player ship handling and autopilot behavior.</p>
                        </div>
                        <section class="card settings-group">
                            <h3>Ship handling</h3>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="Warp speed" @bind-Value="Form.WarpSpeedMultiplier"
                                    Description="Scales fitted warp speed after skills and modules, including normal warp acceleration and braking."
                                    ExampleAmount="3" ExampleUnit="AU/s" />
                                <MultiplierControl Label="Align speed" @bind-Value="Form.AlignSpeedMultiplier"
                                    Description="2× halves inertia time. Also improves turning and acceleration; top subwarp speed is unchanged."
                                    ExampleAmount="10" ExampleUnit="seconds to align from rest" Speed="true" />
                            </div>
                        </section>
                        <section class="card settings-group">
                            <h3>Autopilot</h3>
                            <p class="muted">For solo play, try 2× warp, 1.25× align and 0 metres for autopilot landings.</p>
                            <div class="settings-fields">
                                <SettingField Label="Autopilot gate landing distance (metres)"
                                              Help="Eden defaults to 15,000 metres. Set 0 to warp close to gates. Normal hull clearance still applies.">
                                    <Control Context="field">
                                        <InputNumber id="@field.Input" @bind-Value="Form.AutopilotGateLandingMeters" min="0" max="100000" step="1" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                            </div>
                        </section>
                    </section>
                    <section id="settings-Industry" class="settings-panel" aria-labelledby="heading-Industry"
                             hidden="@(Workspace.Activity != SettingsActivity.Industry)">
                        <div class="settings-panel-heading">
                            <h2 id="heading-Industry">Industry</h2>
                            <p class="muted">Set job speed and material recovery. Installed jobs retain their deadlines.</p>
                        </div>
                        <section class="card settings-group">
                            <h3>Production &amp; blueprint jobs</h3>
                            <p class="muted">2× speed halves a new job’s duration.</p>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="Manufacturing speed" @bind-Value="Form.ManufacturingSpeed"
                                    Description="2× speed halves duration; installed jobs keep their deadlines."
                                    ExampleAmount="100" ExampleUnit="seconds" Reward="false"
                                    Speed="true" Efficiency="false" />
                                <MultiplierControl Label="Research speed" @bind-Value="Form.ResearchSpeed"
                                    Description="Applies to material and time research; installed jobs keep their deadlines."
                                    ExampleAmount="100" ExampleUnit="seconds" Reward="false"
                                    Speed="true" Efficiency="false" />
                                <MultiplierControl Label="Copying speed" @bind-Value="Form.CopyingSpeed"
                                    Description="Scales new copy jobs; licensed runs are unchanged."
                                    ExampleAmount="100" ExampleUnit="seconds" Reward="false"
                                    Speed="true" Efficiency="false" />
                                <MultiplierControl Label="Invention speed" @bind-Value="Form.InventionSpeed"
                                    Description="Scales new invention jobs; success chance and outputs are unchanged."
                                    ExampleAmount="100" ExampleUnit="seconds" Reward="false"
                                    Speed="true" Efficiency="false" />
                            </div>
                        </section>
                        <section class="card settings-group">
                            <h3>Reprocessing</h3>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="Reprocessing efficiency" @bind-Value="Form.ReprocessingEfficiency"
                                    Description="Scales recovery after skills, capped at 100% of available materials."
                                    ExampleAmount="50" ExampleUnit="% recovery" Reward="false"
                                    Speed="false" Efficiency="true" />
                            </div>
                        </section>
                    </section>
                    <section id="settings-PlanetaryIndustry" class="settings-panel" aria-labelledby="heading-PlanetaryIndustry"
                             hidden="@(Workspace.Activity != SettingsActivity.PlanetaryIndustry)">
                        <div class="settings-panel-heading">
                            <h2 id="heading-PlanetaryIndustry">Planetary industry</h2>
                            <p class="muted">Manage colony limits, production, storage and customs.</p>
                        </div>
                        <section class="card settings-group">
                            <h3>Colony limits</h3>
                            <div class="settings-fields">
                                <SettingField Label="Maximum planets (0 = skill-based)"
                                              Help="0 uses one planet plus Interplanetary Consolidation level. 1–100 sets the total per pilot. Existing colonies remain usable if the cap is lowered. Reconnect after the server restarts.">
                                    <Control Context="field">
                                        <InputNumber id="@field.Input" @bind-Value="Form.PlanetaryMaximumPlanets" min="0"
                                            max="@Eden.Gameplay.Planetary.PlanetaryRules.MaximumConfiguredPlanets" step="1" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                            </div>
                        </section>
                        <section class="card settings-group">
                            <h3>Extraction &amp; processing</h3>
                            <p class="muted">Factory output rounds down to whole units, with a minimum of one unit per positive batch. Resize output routes and upgrade links to collect more production. Factory cycles have a one-second minimum.</p>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="Extraction yield" @bind-Value="Form.PlanetaryExtractionYieldMultiplier"
                                    Description="Scales newly installed extractor programs; existing programs keep their yield."
                                    ExampleAmount="100" ExampleUnit="units" Reward="false" Speed="false" Efficiency="false" />
                                <MultiplierControl Label="Factory output" @bind-Value="Form.PlanetaryFactoryOutputMultiplier"
                                    Description="Scales completed factory batch quantities; ingredients per batch stay the same."
                                    ExampleAmount="20" ExampleUnit="units" Reward="false" Speed="false" Efficiency="false" />
                                <MultiplierControl Label="Factory speed" @bind-Value="Form.PlanetaryFactorySpeedMultiplier"
                                    Description="Shortens factory cycles after restart, including running cycles. Extractor timing stays the same."
                                    ExampleAmount="1800" ExampleUnit="seconds per cycle" Reward="false" Speed="true" Efficiency="false" />
                            </div>
                        </section>
                        <section class="card settings-group">
                            <h3>Storage &amp; customs</h3>
                            <p class="muted">After lowering storage capacity, collect any excess goods before adding more.</p>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="Planetary storage capacity" @bind-Value="Form.PlanetaryStorageCapacityMultiplier"
                                    Description="Scales launchpads, storage facilities, command centers and customs offices. Factory buffers retain one batch."
                                    ExampleAmount="10000" ExampleUnit="m³ per launchpad" Reward="false" Speed="false" Efficiency="false" />

                                <SettingField Label="Customs tax (%)"
                                              Help="Exports pay the configured rate on taxable commodity value and imports pay half. Command-center launches have a separate 15% fee. Eden defaults to 17%.">
                                    <Control Context="field">
                                        <InputNumber id="@field.Input" @bind-Value="Form.PlanetaryCustomsTaxPercent" min="0" max="100" step="0.1" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                            </div>
                        </section>
                        <section class="card settings-group">
                            <h3>Command center resources</h3>
                            <p class="muted">After lowering CPU or powergrid, bring over-budget colonies within the new limit before submitting edits.</p>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="Command center CPU" @bind-Value="Form.PlanetaryCpuMultiplier"
                                    Description="Scales CPU supplied at every command center upgrade level."
                                    ExampleAmount="1675" ExampleUnit="tf" Reward="false" Speed="false" Efficiency="false" />
                                <MultiplierControl Label="Command center powergrid" @bind-Value="Form.PlanetaryPowergridMultiplier"
                                    Description="Scales powergrid supplied at every command center upgrade level."
                                    ExampleAmount="6000" ExampleUnit="MW" Reward="false" Speed="false" Efficiency="false" />
                            </div>
                        </section>
                    </section>
                    <section id="settings-Structures" class="settings-panel" aria-labelledby="heading-Structures"
                             hidden="@(Workspace.Activity != SettingsActivity.Structures)">
                        <div class="settings-panel-heading">
                            <h2 id="heading-Structures">Player structures</h2>
                            <p class="muted">Adjust Upwell deployment requirements and lifecycle timers.</p>
                        </div>
                        <section class="card settings-group">
                            <h3>Anchoring requirements</h3>
                            <div class="settings-fields">
                                <SettingField Label="Minimum corporation age for anchoring (days)"
                                              Help="Eden defaults to 7 days. 0 removes the waiting period. Corporation structure management authority is still required.">
                                    <Control Context="field">
                                        <InputNumber id="@field.Input" @bind-Value="Form.StructureMinimumCorporationAgeDays" min="0" step="1" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                            </div>
                        </section>
                        <section class="card settings-group">
                            <h3>Structure timers</h3>
                            <p class="muted">2× speed halves a new timer’s duration. Saved deadlines retain their original terms.</p>
                            <div class="settings-multipliers">
                                <MultiplierControl Label="Anchoring speed" @bind-Value="Form.StructureAnchoringSpeed"
                                    Description="Applies to newly deployed Upwell structures, including navigation structures."
                                    ExampleAmount="24" ExampleUnit="hours" Reward="false" Speed="true" Efficiency="false" />
                                <MultiplierControl Label="Core onlining speed" @bind-Value="Form.StructureOnliningSpeed"
                                    Description="Scales the onlining timer started after installing a quantum core."
                                    ExampleAmount="15" ExampleUnit="minutes" Reward="false" Speed="true" Efficiency="false" />
                                <MultiplierControl Label="Decommissioning speed" @bind-Value="Form.StructureUnanchoringSpeed"
                                    Description="Applies when beginning a new decommissioning timer."
                                    ExampleAmount="7" ExampleUnit="days" Reward="false" Speed="true" Efficiency="false" />
                            </div>
                        </section>
                    </section>
                    <section id="settings-Economy" class="settings-panel" aria-labelledby="heading-Economy"
                             hidden="@(Workspace.Activity != SettingsActivity.Economy)">
                        <div class="settings-panel-heading">
                            <h2 id="heading-Economy">Economy &amp; market</h2>
                            <p class="muted">Choose how markets are stocked and which services charge fees.</p>
                        </div>
                        <EconomySettings Form="Form" Snapshot="MarketSnapshot" />
                    </section>
                    <section id="settings-Environment" class="settings-panel" aria-labelledby="heading-Environment"
                             hidden="@(Workspace.Activity != SettingsActivity.Environment)">
                        <div class="settings-panel-heading">
                            <h2 id="heading-Environment">NPCs &amp; exploration</h2>
                            <p class="muted">Manage ordinary NPC spawns and probe scanning.</p>
                        </div>
                        <section class="card settings-group">
                            <h3>NPC populations</h3>
                            <p class="muted">These switches control new spawns. Living residents remain in the world.</p>
                            <div class="settings-fields">
                                <SettingField Label="Pirates"
                                              Help="Allows new pirate encounters. Living pirates remain when spawning is disabled.">
                                    <Control Context="field">
                                        <InputCheckbox id="@field.Input" @bind-Value="Form.Pirates" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                                <SettingField Label="Empire guards"
                                              Help="Allows new empire security patrols to spawn.">
                                    <Control Context="field">
                                        <InputCheckbox id="@field.Input" @bind-Value="Form.Guards" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                                <SettingField Label="Station convoys"
                                              Help="Allows new NPC freight convoys to spawn around stations.">
                                    <Control Context="field">
                                        <InputCheckbox id="@field.Input" @bind-Value="Form.Convoys" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                                <SettingField Label="Mining fleets"
                                              Help="Allows new NPC mining fleets to spawn. Simulated miners are controlled under Player bots.">
                                    <Control Context="field">
                                        <InputCheckbox id="@field.Input" @bind-Value="Form.Mining" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                                <SettingField Label="Allow Major Threat anomaly tiers in nullsec"
                                              Help="Allows the six advanced nullsec anomaly families to appear without sovereignty upgrades.">
                                    <Control Context="field">
                                        <InputCheckbox id="@field.Input" @bind-Value="Form.MajorThreatAnomalies" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                            </div>
                        </section>
                        <section class="card settings-group">
                            <h3>Probe scanning</h3>
                            <div class="settings-fields">
                                <SettingField Label="Always resolve cosmic signatures"
                                              Help="Shows current-system signatures at 100% so pilots can warp to them and bookmark them without probes.">
                                    <Control Context="field">
                                        <InputCheckbox id="@field.Input" @bind-Value="Form.AlwaysResolvedSignatures" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                            </div>
                        </section>
                    </section>
                    <section id="settings-PlayerBots" class="settings-panel" aria-labelledby="heading-PlayerBots"
                             hidden="@(Workspace.Activity != SettingsActivity.PlayerBots)">
                        <div class="settings-panel-heading">
                            <h2 id="heading-PlayerBots">Player bots</h2>
                            <p class="muted">Manage simulated capsuleers, traffic, combat and hauling.</p>
                        </div>
                        <BotOperatingLimits Form="Form" Regions="Operations.RegionNames" Systems="Operations.SolarSystems"
                                            Changed="StateHasChanged" />
                        <PlayerBotSettings Form="Form" />
                    </section>
                    <section id="settings-Advanced" class="settings-panel" aria-labelledby="heading-Advanced"
                             hidden="@(Workspace.Activity != SettingsActivity.Advanced)">
                        <div class="settings-panel-heading">
                            <h2 id="heading-Advanced">Advanced</h2>
                            <p class="muted">Tune maintenance intervals and override selected prices and manufacturing indices.</p>
                        </div>
                        <section class="card settings-group">
                            <h3>Server maintenance</h3>
                            <div class="settings-fields">
                                <SettingField Label="Checkpoint interval (seconds)"
                                              Help="Time between scheduled world saves. Shorter intervals save progress more often.">
                                    <Control Context="field">
                                        <InputNumber id="@field.Input" @bind-Value="Form.CheckpointSeconds" min="1" max="300" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                                <SettingField Label="Market polling interval (milliseconds)"
                                              Help="How often market maintenance checks for due work, including expiring orders.">
                                    <Control Context="field">
                                        <InputNumber id="@field.Input" @bind-Value="Form.MarketPollMilliseconds" min="100" max="60000" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                                <SettingField Label="Resource check interval (seconds)"
                                              Help="How often resource maintenance checks for scheduled belt renewals.">
                                    <Control Context="field">
                                        <InputNumber id="@field.Input" @bind-Value="Form.ResourceCheckSeconds" min="1" max="3600" aria-describedby="@field.Help" />
                                    </Control>
                                </SettingField>
                            </div>
                        </section>
                        <OverrideEditor Draft="Workspace.Draft" DraftChanged="Workspace.ChangeOverrides" Active="State.Active.Draft"
                                        Original="Original" Pending="State.Pending?.Draft" />
                    </section>
                </fieldset>
                <ValidationSummary />
            </EditForm>
            <section class="card settings-review" aria-labelledby="settings-changes">
                <h2 id="settings-changes">Changed values</h2>
                @if (Unsaved)
                {
                    @if (DraftChanges is { } changes)
                    {
                        <div class="scroll">
                            <table>
                                <thead><tr><th scope="col">Setting</th><th scope="col">Saved</th><th scope="col">Draft</th></tr></thead>
                                <tbody>
                                    @foreach (var change in changes)
                                    {
                                        <tr><th scope="row">@change.Field</th><td>@change.Before</td><td>@change.After</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="error">Correct invalid values to preview all changes.</p>
                    }
                }
                else
                {
                    <p class="muted">No unsaved changes.</p>
                }
            </section>
            <details class="card settings-review">
                <summary>Original, active and pending values</summary>
                <p class="muted">Original values were captured when this saved world was upgraded.</p>
                <div class="scroll">
                    <table>
                        <thead><tr><th>Setting</th><th>Original</th><th>Active</th><th>Pending restart</th></tr></thead>
                        <tbody>
                            @foreach (var row in ConfigurationDisplay.Settings(
                                Original.Settings, State.Active.Draft.Settings, State.Pending?.Draft.Settings))
                            {
                                <tr><td>@row.Label</td><td>@row.Original</td><td>@row.Active</td><td>@row.Pending</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
            <div class="toolbar settings-draft-tools">
                <button type="button" class="secondary" @onclick="Load" disabled="@Busy">Reload saved values</button>
                <button type="button" class="secondary" @onclick="Reset" disabled="@Busy">Reset draft to original</button>
            </div>
            <div class="settings-save-bar">
                @if (Error is not null)
                {
                    <p class="error" role="alert">@Error</p>
                }
                @if (Message is not null)
                {
                    <p class="notice" role="status">@Message</p>
                }
                <div class="toolbar">
                    <span role="status">@(Unsaved ? "Unsaved changes" : State.Pending is not null ? "Saved · pending restart" : "Active settings")</span>
                    <button type="button" class="secondary" @onclick="Validate" disabled="@Busy">Validate draft</button>
                    <button type="button" class="secondary" @onclick="Discard" disabled="@(Busy || !Unsaved)">Discard unsaved changes</button>
                    <button type="submit" form="world-settings" disabled="@(Busy || !Unsaved)">Save for restart</button>
                </div>
            </div>
        </div>
    </div>
}
