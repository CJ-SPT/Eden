@inherits LayoutComponentBase
<header>
    <img src="eden-server.svg" width="48" height="48" alt="" />
    <div><strong>EDEN</strong><br /><small>Local administration</small></div>
    <AuthorizeView>
        <Authorized>
            <nav>
                <NavLink href="/" Match="NavLinkMatch.All">Settings</NavLink>
                <NavLink href="/catalog">Catalog</NavLink>
                <NavLink href="/mods">Mods</NavLink>
                <NavLink href="/revisions">Revisions</NavLink>
                <NavLink href="/population">Population</NavLink>
                <NavLink href="/performance">Performance</NavLink>
                <form method="post" action="/logout"><AntiforgeryToken /><button class="secondary">Sign out</button></form>
            </nav>
        </Authorized>
    </AuthorizeView>
</header>
<main>@Body</main>
