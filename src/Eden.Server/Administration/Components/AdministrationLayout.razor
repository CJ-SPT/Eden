@inherits LayoutComponentBase
<header class="admin-header">
    <div class="admin-brand">
        <img src="eden-server.svg" width="40" height="40" alt="" />
        <div><strong>EDEN</strong><small>Server administration</small></div>
    </div>
    <AuthorizeView>
        <Authorized>
            <nav class="admin-nav" aria-label="Administration">
                <NavLink href="/" Match="NavLinkMatch.All">Settings</NavLink>
                <NavLink href="/catalog">Catalog</NavLink>
                <NavLink href="/mods">Mods</NavLink>
                <NavLink href="/revisions">Revisions</NavLink>
                <NavLink href="/population">Population</NavLink>
                <NavLink href="/optional-data">Optional data</NavLink>
                <NavLink href="/performance">Performance</NavLink>
                <NavLink href="/world">World</NavLink>
                <form method="post" action="/logout"><AntiforgeryToken /><button class="secondary">Sign out</button></form>
            </nav>
        </Authorized>
    </AuthorizeView>
</header>
<main>@Body</main>
