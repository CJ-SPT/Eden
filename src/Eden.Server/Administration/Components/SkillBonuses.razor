@using Eden.Gameplay.Skills
<section class="skill-section">
    <div class="skill-bonus-heading">
        <h3>Bonuses</h3>
        <button type="button" class="secondary" @onclick="ToggleTechnical">
            @(TechnicalEditing ? "Back to bonuses" : "Advanced: edit technical rules")
        </button>
    </div>
    @if (TechnicalEditing)
    {
        <SkillAdvancedEffects Form="Form" Options="Options" Editable="Editable" Changed="Changed" />
    }
    else
    {
        @if (!Editable)
        {
            <p class="notice">This original skill uses a dedicated gameplay calculation, so its bonuses are read-only.
                Create a new skill to add a supported custom bonus.</p>
        }
        <fieldset disabled="@(!Editable)">
            @if (HasMiningBonus)
            {
                var mining = Form.Attributes.Single(attribute => attribute.AttributeId == SkillBonusEditing.MiningBonusAttribute);
                <div class="skill-effect-card" data-bonus="ore-mining-yield">
                    <div class="skill-bonus-heading">
                        <h3>Ore mining yield</h3>
                        <button type="button" class="secondary" @onclick="RemoveMining">Remove bonus</button>
                    </div>
                    <label class="skill-bonus-value">Bonus per skill level (%)
                        <InputNumber @bind-Value="mining.Value" step="any" @bind-Value:after="ValueChanged" />
                    </label>
                    <p>Applies to ore mining lasers and strip miners requiring Mining.</p>
                    <p class="muted">Ice harvesters, gas harvesters and mining drones do not receive this bonus.</p>
                    <div class="skill-preview scroll">
                        <table>
                            <caption>Extra ore yield from this skill</caption>
                            <thead><tr>@for (int level = 1; level <= 5; level++) { <th>Level @level</th> }</tr></thead>
                            <tbody><tr>@for (int level = 1; level <= 5; level++)
                                { <td>@((mining.Value * level).ToString("+0.##;-0.##;0"))%</td> }</tr></tbody>
                        </table>
                        <p class="muted">At level V: @((1 + mining.Value * 5 / 100).ToString("0.##"))× yield from this bonus.
                            Other skills and bonuses can multiply the result.</p>
                    </div>
                    <details>
                        <summary>Technical details</summary>
                        <p class="muted">The editor manages the level scaling and yield application together.
                            Effect @SkillBonusEditing.MiningScalingEffect scales attribute @SkillBonusEditing.MiningBonusAttribute;
                            effect @SkillBonusEditing.MiningYieldEffect applies it to matching modules.</p>
                    </details>
                </div>
            }
            else if (SkillBonusEditing.CanConfigureMining(Form, Options) && SkillBonusEditing.HasMiningRules(Form, Options))
            {
                <div class="notice">
                    <h3>Ore mining yield needs setup</h3>
                    @if (!Form.Effects.Any(effect => effect.EffectId == SkillBonusEditing.MiningScalingEffect)
                        && Form.Attributes.FirstOrDefault(attribute => attribute.AttributeId == SkillBonusEditing.MiningBonusAttribute) is { } flat)
                    {
                        <p>This bonus stays at @flat.Value% at every trained level.</p>
                    }
                    else
                    {
                        <p>The mining bonus has incomplete or overlapping rules.</p>
                    }
                    <p>Keep the current value and let the editor connect the rules.</p>
                    <button type="button" @onclick="AddMining">Make it scale with skill level</button>
                </div>
            }
            @if (Form.Effects.Any(effect => !HasMiningBonus
                || effect.EffectId is not (SkillBonusEditing.MiningScalingEffect or SkillBonusEditing.MiningYieldEffect)))
            {
                <p class="notice">Existing technical rules are preserved. Open Advanced to review or edit rules
                    that cannot be shown as a guided bonus.</p>
            }
            else if (!HasMiningBonus)
            {
                <p class="muted">No bonuses added. Choose a bonus to set what this skill improves.</p>
            }
            @if (!HasMiningBonus && SkillBonusEditing.CanConfigureMining(Form, Options)
                && !SkillBonusEditing.HasMiningRules(Form, Options))
            {
                <button type="button" class="secondary" @onclick="() => ChoosingBonus = !ChoosingBonus">Add bonus</button>
                @if (ChoosingBonus)
                {
                    <div class="skill-recipe">
                        <h3>Choose a bonus</h3>
                        <p>Ore mining yield increases how much ore matching mining modules collect per cycle.</p>
                        <button type="button" @onclick="AddMining">Add ore mining yield</button>
                    </div>
                }
            }
        </fieldset>
    }
</section>

@code {
    [Parameter, EditorRequired] public SkillForm Form { get; set; } = null!;
    [Parameter, EditorRequired] public SkillEditorChoices Options { get; set; } = null!;
    [Parameter] public bool Editable { get; set; } = true;
    [Parameter] public EventCallback Changed { get; set; }
    protected bool TechnicalEditing;
    private bool ChoosingBonus;
    private SkillForm? PreviousForm;
    private bool HasMiningBonus => SkillBonusEditing.HasMiningBonus(Form, Options);

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(PreviousForm, Form))
        {
            PreviousForm = Form;
            TechnicalEditing = false;
            ChoosingBonus = false;
        }
    }

    protected void ToggleTechnical() => TechnicalEditing = !TechnicalEditing;

    protected async Task AddMining()
    {
        if (!Editable || !SkillBonusEditing.CanConfigureMining(Form, Options))
        {
            return;
        }
        SkillBonusEditing.AddMining(Form, Options);
        ChoosingBonus = false;
        await Changed.InvokeAsync();
    }

    protected async Task RemoveMining()
    {
        if (!Editable || !HasMiningBonus)
        {
            return;
        }
        SkillBonusEditing.RemoveMining(Form, Options);
        await Changed.InvokeAsync();
    }

    private Task ValueChanged() => Changed.InvokeAsync();
}
