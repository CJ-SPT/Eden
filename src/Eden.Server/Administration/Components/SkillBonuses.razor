@using Eden.Gameplay.Dogma
@using Eden.Gameplay.Skills
<section class="skill-section">
    <h3>Bonuses and effects</h3>
    <p class="muted">An <strong>attribute</strong> stores a number, such as 25. An <strong>effect</strong> is the rule that uses it:
        what changes, which items it affects, and how the number is applied. An attribute alone does not grant a bonus.</p>
    @if (!Editable)
    {
        <p class="notice">This original skill uses a dedicated gameplay calculation, so its bonuses are read-only.
            Create a new skill to add a supported custom bonus.</p>
    }
    <fieldset disabled="@(!Editable)">
        @if (SkillBonusEditing.SupportsMining(Options))
        {
            <div class="skill-recipe">
                <h3>Ore mining yield</h3>
                <p>Add the two linked effects and their percentage value. New values start at 25% per level; existing values are kept.
                    Edit the percentage below.
                    Applies to fitted modules requiring Mining, including ore mining lasers and strip miners.
                    Ice harvesters, gas harvesters and mining drones do not receive this bonus.</p>
                <button type="button" class="secondary" @onclick="AddMining">Add ore mining yield bonus</button>
            </div>
        }
        @foreach (var effect in Form.Effects)
        {
            var option = SkillChoiceSearch.Index(Options.Effects).GetValueOrDefault(effect.EffectId);
            <div class="skill-effect-card" @key="effect">
                <div class="skill-effect-heading">
                    <SkillChoice TValue="int" Label="Effect rule" Options="Options.Effects" ShowDescription="false" IncludeId="true"
                                 @bind-Value="effect.EffectId" @bind-Value:after="EffectChanged" />
                    <button type="button" class="secondary" @onclick="() => Remove(effect)">Remove effect</button>
                </div>
                @if (option is not null)
                {
                    @foreach (var modifier in option.Modifiers)
                    {
                        <p class="skill-description">@modifier.Description</p>
                    }
                    @foreach (int id in SkillBonusEditing.InputIds(option))
                    {
                        var input = Form.Attributes.FirstOrDefault(attribute => attribute.AttributeId == id);
                        var attributeOption = SkillChoiceSearch.Index(Options.Attributes).GetValueOrDefault(id);
                        @if (input is not null)
                        {
                            <label>@(attributeOption?.Name ?? $"Attribute {id}") @InputUnit(id)
                                <InputNumber @bind-Value="input.Value" step="any" />
                            </label>
                            <small class="muted">Shared by every effect using this attribute. @attributeOption?.Description</small>
                        }
                        else if (Editable && attributeOption is not null)
                        {
                            <button type="button" class="secondary" @onclick="EffectChanged">Add missing input value</button>
                        }
                    }
                    @if (option.Id == SkillBonusEditing.MiningYieldEffect && HasMiningScaling
                        && Form.Attributes.FirstOrDefault(attribute => attribute.AttributeId == SkillBonusEditing.MiningBonusAttribute) is { } mining)
                    {
                        <div class="skill-preview scroll">
                            <p><strong>@mining.Value% ore mining yield per level</strong> · contribution from this pair of effects alone.</p>
                            <table>
                                <caption>Yield compared with the same module without this bonus</caption>
                                <thead><tr><th>Skill level</th>@for (int level = 1; level <= 5; level++) { <th>@level</th> }</tr></thead>
                                <tbody><tr><th>Yield multiplier</th>@for (int level = 1; level <= 5; level++)
                                    { <td>@((1 + mining.Value * level / 100).ToString("0.##"))×</td> }</tr></tbody>
                            </table>
                            <p class="muted">25% gives +25% at level I and +125% at level V (2.25× yield). Levels add together;
                                separate skills and other bonuses can multiply the result.</p>
                        </div>
                    }
                    @if (option.Modifiers.Count == 0)
                    {
                        <p class="muted skill-description">@option.Description</p>
                    }
                    <details><summary>Catalog details</summary>
                        <p class="muted skill-description">Effect @option.Id · @option.Description</p>
                        <label><InputCheckbox @bind-Value="effect.IsDefault" /> Default effect (client marker; does not change bonus strength)</label>
                    </details>
                }
            </div>
        }
        <button type="button" class="secondary" @onclick="AddEffect">Add effect rule</button>
        <p class="muted">Choose supported existing rules. Scaling by level and applying a bonus may require two linked effects,
            as shown in the mining recipe. New rule implementations and arbitrary targets cannot be authored here.</p>
        <details>
            <summary>Advanced attribute values</summary>
            <p class="muted">These are the stored inputs used above, plus any other catalog attributes on this skill.
                Percent rules use 25 for 25%; multiplier rules use 1.25 for 1.25×.
                Removing an effect keeps its attribute values for reuse.</p>
            @foreach (var attribute in Form.Attributes)
            {
                <div class="skill-input-row" @key="attribute">
                    <SkillChoice TValue="int" Label="Attribute" Options="Options.Attributes" @bind-Value="attribute.AttributeId" />
                    <label>Stored value <InputNumber @bind-Value="attribute.Value" step="any" /></label>
                    <button type="button" class="secondary" @onclick="() => Remove(attribute)">Remove</button>
                </div>
            }
            <button type="button" class="secondary" @onclick="AddAttribute">Add attribute</button>
        </details>
    </fieldset>
</section>

@code {
    [Parameter, EditorRequired] public SkillForm Form { get; set; } = null!;
    [Parameter, EditorRequired] public SkillEditorChoices Options { get; set; } = null!;
    [Parameter] public bool Editable { get; set; } = true;
    [Parameter] public EventCallback Changed { get; set; }
    private bool HasMiningScaling => Form.Effects.Any(effect => effect.EffectId == SkillBonusEditing.MiningScalingEffect);

    private string InputUnit(int id)
    {
        var modifiers = SkillBonusEditing.SelectedEffects(Form, Options)
            .SelectMany(option => option.Modifiers).ToArray();
        bool perLevel = modifiers.Any(modifier => modifier.Local
            && modifier.SourceAttributeId == (int)DogmaAttributeId.SkillLevel && modifier.TargetAttributeId == id
            && modifier.Operation is DogmaOperation.PreMultiply or DogmaOperation.PostMultiply);
        bool percent = modifiers.Any(modifier => modifier.SourceAttributeId == id && modifier.Operation == DogmaOperation.PostPercent);
        bool multiplier = modifiers.Any(modifier => modifier.SourceAttributeId == id
            && modifier.Operation is DogmaOperation.PreMultiply or DogmaOperation.PostMultiply);
        return (percent, perLevel) switch
        {
            (true, true) => "(% per level)",
            (true, false) => "(%)",
            (false, true) => "(per level)",
            _ when multiplier => "(multiplier; 1 = unchanged)",
            _ => "(stored value)",
        };
    }

    private async Task AddMining()
    {
        SkillBonusEditing.AddMining(Form, Options);
        await Changed.InvokeAsync();
    }

    private async Task EffectChanged()
    {
        SkillBonusEditing.EnsureInputs(Form, Options);
        await Changed.InvokeAsync();
    }

    private async Task AddEffect()
    {
        Form.Effects.Add(new());
        await Changed.InvokeAsync();
    }

    private async Task AddAttribute()
    {
        Form.Attributes.Add(new());
        await Changed.InvokeAsync();
    }

    private async Task Remove(SkillForm.EffectInput effect)
    {
        Form.Effects.Remove(effect);
        await Changed.InvokeAsync();
    }

    private async Task Remove(SkillForm.AttributeInput attribute)
    {
        Form.Attributes.Remove(attribute);
        await Changed.InvokeAsync();
    }
}
