@page "/world/setup"
@attribute [Authorize(Policy = AdministratorAccounts.Policy)]
@inject AdministrationSite Site
<PageTitle>World setup · Eden</PageTitle>
@if (Site.Setup is { } setup)
{
    <h1>Set up your world</h1>
    <p>New saves use Established Universe bot careers and traffic. Account access opens when the world is ready.</p>
    @if (setup.Previous is not null)
    {
        <p>The configuration draft starts with your previous world's active settings.</p>
    }
    @if (setup.Previous?.Settings is null or { Economy.StandardMarket: true })
    {
        <p>The Standard market uses captured public market orders. If you haven't installed a compatible snapshot,
            run this command on the server before creating the world.</p>
        <pre><code>@setup.MarketImportCommand</code></pre>
    }
    <form method="post" action="/api/admin/world/setup" class="card">
        <AntiforgeryToken />
        <details>
            <summary>Advanced settings</summary>
            <p>Open a configuration draft in a new tab, edit it, and paste the complete JSON below.
                The draft includes market and bot settings, balance and service costs, and economic overrides.</p>
            <p><a href="/api/admin/world/setup-draft" target="_blank" rel="noopener">Download configuration draft</a></p>
            <label>World configuration JSON <textarea name="document" rows="10" spellcheck="false"></textarea></label>
        </details>
        <button type="submit">Create world and start</button>
    </form>
}
else
{
    <h1>World setup complete</h1>
    <p><a href="/world">Open the World page</a></p>
}
