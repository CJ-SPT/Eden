<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>../../assets/icons/eden-server.ico</ApplicationIcon>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);data/**;data.copy-*/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Eden.Modding/Eden.Modding.csproj" />
    <ProjectReference Include="../Eden.Data/Eden.Data.csproj" />
    <ProjectReference Include="../Eden.Gameplay/Eden.Gameplay.csproj" />
    <ProjectReference Include="../Eden.Infrastructure/Eden.Infrastructure.csproj" />
    <ProjectReference Include="../Eden.World/Eden.World.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="all" />
    <Protobuf Include="../Eden.Protocol/Gateway/services.proto" ProtoRoot="../Eden.Protocol/Gateway" GrpcServices="Server" />
    <ProjectReference Include="../Eden.Protocol/Eden.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Eden.Protocol.Tests" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <Content Include="../../tools/mod_client_loader.py" Link="skill-tools/mod_client_loader.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../tools/Build-SkillClient.py" Link="skill-tools/Build-SkillClient.py" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Modding/Client/automining.py" LogicalName="Eden.AutoMining.Client" />
    <Content
      Include="../../tools/skill_client_overlay.py"
      Link="skill-tools/skill_client_overlay.py"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
